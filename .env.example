# Public address shown for “Prefer email?” mailto links (must match a real mailbox or alias at your domain).
NEXT_PUBLIC_FEEDBACK_EMAIL=feedback@mentrixa.one

# Where Resend delivers contact-form submissions. If unset, falls back to NEXT_PUBLIC_FEEDBACK_EMAIL then the default above.
# For one inbox: set both to the same address, and configure MX + mailbox at your DNS/email provider for direct mailto delivery.
CONTACT_INBOX_EMAIL=
