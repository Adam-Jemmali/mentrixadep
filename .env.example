# ============================================================================
# Mentrixa Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================================

# ─── Supabase (required) ─────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Stripe (required for payments) ──────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Google Gemini AI (required for quests, studio, duels) ───────────────────
GEMINI_API_KEY=your-gemini-api-key

# ─── Google Cloud Vision (optional — league forum screenshot Safe Search) ───
# GOOGLE_CLOUD_VISION_API_KEY=your-vision-api-key

# ─── Resend (required for transactional emails) ──────────────────────────────
RESEND_API_KEY=re_...

# ─── Skill tree Frontier (optional rollback) ─────────────────────────────────
# Default ON. Set to 0 to show explorer-only mastery and skip unlock gate.
# SKILL_TREE_FRONTIER=0
# Primary app URL (used for metadata, redirects, email links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Alias (used when APP_URL is not set)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: override email link base URL in production
# NEXT_PUBLIC_EMAIL_APP_URL=https://mentrixa.one
# Optional: override email asset origin in production
# NEXT_PUBLIC_EMAIL_ASSET_ORIGIN=https://mentrixa.one

# ─── Google OAuth (optional — enables Google Sign-In) ────────────────────────
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ─── Cloudflare Turnstile (optional — CAPTCHA on auth forms) ─────────────────
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-site-key
# TURNSTILE_SECRET_KEY=your-secret-key

# ─── Web Push / VAPID (optional — push notifications) ────────────────────────
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
# VAPID_PRIVATE_KEY=your-vapid-private-key

# ─── Upstash Redis (optional — shared cache + rate limits across Vercel instances) ─
# UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ─── Cron Jobs (required in production for webhook auth) ─────────────────────
# Secret used to authenticate Vercel Cron requests
# CRON_SECRET=your-random-cron-secret

# ─── Observability (optional — Sentry error tracking) ────────────────────────
# NEXT_PUBLIC_SENTRY_DSN=https://your-key@sentry.io/your-project
# SENTRY_ORG=your-sentry-org
# SENTRY_PROJECT=your-sentry-project

# ─── Node Environment ────────────────────────────────────────────────────────
NODE_ENV=development
