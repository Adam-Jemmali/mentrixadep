{
  "regions": ["iad1"],
  "functions": {
    "src/app/api/tutor/studio-stream/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/**/route.ts": {
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(self)" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/refresh-division-leaderboard",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/unlock-expired-slots",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/complete-sessions",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/send-reminders",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/pre-session-brief",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/process-payouts",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/verification-overdue",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/division-weekly",
      "schedule": "15 0 * * 1"
    }
  ]
}
